# 🟠 Production (Local Simulation)
# `npm run build`
# `npm run start:prod`
#   - Compiles TS → dist/
#   - Runs pure Node
#   - Uses .env.production
#   - Exactly how Render runs it

# ----------------------------------------------------

#  🚀 What Render Does

# Render runs:
#   `npm install`
#   `npm run build`
#   `node dist/server.js`
#     - So your scripts must match that.
#     - That is industry standard.


NODE_ENV=production
PORT=4000

JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key
# use this command to generate a secure JWT secrets ✅
# `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`

DATABASE_URL=your-production-database-url
SUPABASE_URL_PUBLIC=https://ymongaqnsxjtuqmmcoye.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_PORTAL_BUCKET=portal-assets
SUPABASE_TEMP_BUCKET=temp-uploads
# Service role key — required for private bucket operations (signed URLs, moves, deletes).
# Server-only secret — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

FRONTEND_ORIGINS=https://your-custom-domain.com,https://yourapp.vercel.app

ZOOM_ACCOUNT_ID=your-account-id 
ZOOM_CLIENT_ID=your-client-id
ZOOM_CLIENT_SECRET=your-secret
ZOOM_HOST_EMAIL=example@mail.com