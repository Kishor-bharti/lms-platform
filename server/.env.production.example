# 🟠 Production
# `npm run build && npm run start:prod`
#  - Compiles TS → dist/
#  - Runs pure Node
#  - Uses .env.production

NODE_ENV=production
PORT=4000

JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key
# use this command to generate a secure JWT secret ✅
# `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`

DATABASE_URL=postgresql://lms_admin:password@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/lmsdb

# AWS S3 Storage
AWS_REGION=ap-south-1
# On EC2 with an IAM instance role (lms-ec2-s3-role), omit the two lines below —
# the SDK picks up credentials from the instance metadata service automatically.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
S3_PORTAL_BUCKET=portal-assets
S3_TEMP_BUCKET=temp-uploads
S3_QUIZ_BUCKET=quiz-images

# Removed — Supabase replaced by AWS S3
# SUPABASE_URL_PUBLIC=https://ymongaqnsxjtuqmmcoye.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_PORTAL_BUCKET=portal-assets
# SUPABASE_TEMP_BUCKET=temp-uploads

FRONTEND_ORIGINS=https://yourdomain.com

ZOOM_ACCOUNT_ID=your-account-id
ZOOM_CLIENT_ID=your-client-id
ZOOM_CLIENT_SECRET=your-secret
ZOOM_HOST_EMAIL=example@mail.com
