# 🟠 Production (Local Simulation)
# `npm run build`
# `npm run start:prod`
#   - Compiles TS → dist/
#   - Runs pure Node
#   - Uses .env.production
#   - Exactly how Render runs it

# ----------------------------------------------------

#  🚀 What Render Does

# Render runs:
#   `npm install`
#   `npm run build`
#   `node dist/server.js`
#     - So your scripts must match that.
#     - That is industry standard.


NODE_ENV=production
PORT=4000

JWT_SECRET=your-jwt-secret-key

DATABASE_URL=your-production-database-url

FRONTEND_ORIGINS=https://your-custom-domain.com,https://yourapp.vercel.app

ZOOM_ACCOUNT_ID=your-account-id 
ZOOM_CLIENT_ID=your-client-id
ZOOM_CLIENT_SECRET=your-secret
ZOOM_HOST_EMAIL=example@mail.com