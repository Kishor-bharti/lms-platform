# 🟢 Development
# `npm run dev`
#  - Runs TS directly
#  - Auto-restarts on file changes
#  - Uses .env.development
#  - Fast iteration

NODE_ENV=development
PORT=4000

JWT_SECRET=your-dev-secret-key
JWT_REFRESH_SECRET=your-dev-refresh-secret-key
# use this command to generate a secure JWT secret ✅
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`

DATABASE_URL=postgresql://postgres:@localhost:5432/100xlearning

# AWS S3 Storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_PORTAL_BUCKET=portal-assets
S3_TEMP_BUCKET=temp-uploads
S3_QUIZ_BUCKET=quiz-images

# Removed — Supabase replaced by AWS S3
# SUPABASE_URL_PUBLIC=https://ymongaqnsxjtuqmmcoye.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_PORTAL_BUCKET=portal-assets
# SUPABASE_TEMP_BUCKET=temp-uploads

FRONTEND_ORIGINS=http://localhost:3000

ZOOM_ACCOUNT_ID=your-account-id
ZOOM_CLIENT_ID=your-client-id
ZOOM_CLIENT_SECRET=your-secret
ZOOM_HOST_EMAIL=example@mail.com
