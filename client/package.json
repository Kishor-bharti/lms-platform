{
  "name": "lms-platform",
  "version": "1.2.4",
  "description": "lms-learning-platform-react-app",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kishor-bharti/lms-platform.git"
  },
  "keywords": [
    "react",
    "reactjs",
    "dashboard",
    "dashboard-react",
    "lms-platform"
  ],
  "author": "Kishor",
  "license": "other",
  "bugs": {
    "url": "https://github.com/Kishor-bharti/lms-platform.git/issues"
  },
  "homepage": "",
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env PUBLIC_URL=/ react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "compile:scss": "sass src/assets/scss/lms-platform.scss src/assets/css/lms-platform.css",
    "minify:scss": "sass src/assets/scss/lms-platform.scss src/assets/css/lms-platform.min.css --style compressed",
    "build:scss": "npm run compile:scss && npm run minify:scss"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "axios": "^1.7.9",
    "bootstrap": "4.6.2",
    "jsonpointer": "^5.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.21.1",
    "react-scripts": "5.0.1",
    "reactstrap": "8.10.0",
    "sass": "1.69.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "overrides": {
    "svgo": "3.0.2",
    "fsevents": "2.3.2",
    "chokidar": "3.5.3"
  }
}
