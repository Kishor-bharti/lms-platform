  "bugs": {
    "url": "https://github.com/Kishor-bharti/lms-platform.git/issues"
  },
  "homepage": "",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:local": "cross-env CI=false react-scripts build",
    "build:ci": "cross-env CI=true react-scripts build",
    "test": "react-scripts test",
    "lint": "eslint src",
    "eject": "react-scripts eject",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "compile:scss": "sass src/assets/scss/10xaccel.scss src/assets/css/10xaccel.css",
    "minify:scss": "sass src/assets/scss/10xaccel.scss src/assets/css/10xaccel.min.css --style compressed",
    "build:scss": "npm run compile:scss && npm run minify:scss"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "axios": "^1.7.9",
    "bootstrap": "4.6.2",
    "jsonpointer": "^5.0.1",
    "katex": "^0.16.33",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.21.1",
    "react-scripts": "5.0.1",
    "reactstrap": "8.10.0",
    "recharts": "^3.8.0",
    "sass": "1.69.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "overrides": {
    "svgo": "3.0.2",
